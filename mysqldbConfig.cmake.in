@PACKAGE_INIT@
 include("${CMAKE_CURRENT_LIST_DIR}/MysqlDBTargets.cmake")

find_dependency(boost_mysql CONFIG REQUIRED)
find_dependency(boost_charconv CONFIG REQUIRED)
find_dependency(OpenSSL REQUIRED)

 set_and_check(MysqlDB_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include/mysqldb")

 set(MysqlDB_FOUND TRUE)